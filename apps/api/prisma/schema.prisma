generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(3)
  projects     Project[]

  @@map("users")
}

model Project {
  id           String        @id @db.Uuid
  name         String
  description  String
  ownerId      String        @map("owner_id") @db.Uuid
  createdAt    DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @map("updated_at") @db.Timestamptz(3)
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  environments Environment[]
  apiKeys      ApiKey[]

  @@unique([ownerId, name])
  @@map("projects")
}

model Environment {
  id        String        @id @db.Uuid
  projectId String        @map("project_id") @db.Uuid
  name      String
  createdAt DateTime      @map("created_at") @db.Timestamptz(3)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secrets   Secret[]
  grants    ApiKeyGrant[]

  @@unique([projectId, name])
  @@map("environments")
}

model Secret {
  id                   String      @id @db.Uuid
  environmentId        String      @map("environment_id") @db.Uuid
  key                  String
  encryptedValue       Bytes       @map("encrypted_value")
  nonce                Bytes
  encryptionKeyVersion Int         @map("encryption_key_version")
  createdAt            DateTime    @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @map("updated_at") @db.Timestamptz(3)
  environment          Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  // Its leading column also serves lookups by environment.
  @@unique([environmentId, key])
  @@map("secrets")
}

model ApiKey {
  id         String        @id @db.Uuid
  projectId  String        @map("project_id") @db.Uuid
  name       String
  keyHash    String        @unique @map("key_hash")
  keyPrefix  String        @map("key_prefix")
  expiresAt  DateTime?     @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime?     @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime      @map("created_at") @db.Timestamptz(3)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grants     ApiKeyGrant[]

  @@index([projectId])
  @@map("api_keys")
}

model ApiKeyGrant {
  apiKeyId      String      @map("api_key_id") @db.Uuid
  environmentId String      @map("environment_id") @db.Uuid
  permission    String
  apiKey        ApiKey      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, environmentId, permission])
  @@index([environmentId])
  @@map("api_key_grants")
}

/// No foreign keys: history outlives what it describes.
model AuditLog {
  id            String   @id @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  environmentId String?  @map("environment_id") @db.Uuid
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String   @map("resource_id") @db.Uuid
  ipAddress     String?  @map("ip_address")
  metadata      Json
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)

  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("audit_logs")
}
