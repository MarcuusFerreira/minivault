{
  "name": "minivault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w packages/contracts && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build -w packages/contracts && npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/api",
    "arch": "npm run arch -w apps/api",
    "engine:test": "sh scripts/go.sh test -race ./...",
    "engine:vet": "sh scripts/go.sh vet ./..."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
