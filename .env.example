# Run `sh scripts/init-env.sh` to generate a .env with random values.

# Host port of the web application, and the matching browser origin.
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
# Set to true when served over HTTPS.
COOKIE_SECURE=false

POSTGRES_PASSWORD=
# At least 32 characters.
JWT_SECRET=
# Shared by the API and the secrets engine. At least 32 characters.
ENGINE_AUTH_TOKEN=
# <version>:<base64 of 32 bytes>, comma separated. Keep old versions to decrypt old secrets.
MASTER_KEYS=
ACTIVE_KEY_VERSION=1
# Password of the demonstration user created by the demo profile.
DEMO_USER_PASSWORD=
